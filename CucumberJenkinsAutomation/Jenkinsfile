pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    stages {

        stage('Verify Tools') {
            steps {
                bat 'java -version'
                bat 'mvn -version'
            }
        }

      stage('Run Cucumber Tests') {
         steps {
        dir('CucumberJenkinsAutomation') {
            bat 'mvn clean test'
        }
    }
}
    }

   post {
    always {
        junit allowEmptyResults: true,
              testResults: 'CucumberJenkinsAutomation/target/surefire-reports/TEST-*.xml'

        archiveArtifacts artifacts: 'CucumberJenkinsAutomation/target/cucumber-report.html,CucumberJenkinsAutomation/target/cucumber.json',
                         allowEmptyArchive: true

        publishHTML(target: [
            reportDir: 'CucumberJenkinsAutomation/target',
            reportFiles: 'cucumber-report.html',
            reportName: 'Cucumber HTML Report',
            keepAll: true,
            alwaysLinkToLastBuild: true,
            allowMissing: true
        ])
    }
}
}